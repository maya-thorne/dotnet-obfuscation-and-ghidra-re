// ==============================================================================
// Elasticsearch & Kibana KQL Production Threat Hunting Queries
// Target: .NET Obfuscators, Native Packers, and Droppers
// Author: Maya Thorne (Systems & Detection Engineering Research)
// License: MT-SRL
// ==============================================================================

// 1. Process execution from temporary folder with random executable name
event.category: "process" and process.executable: *\AppData\Local\Temp\*.exe and not process.parent.executable: *\setup.exe

// 2. ConfuserEx CLI execution or reverse engineering tools activity
event.category: "process" and (process.executable: *\Confuser.CLI.exe or process.executable: *\dnSpy.exe or process.name: "Confuser.CLI.exe")

// 3. Execution with hidden window telemetry
event.category: "process" and (process.command_line: "*ShowWindow*" or process.command_line: "*hidden*")

// 4. In-memory assembly reflection execution
event.category: "process" and process.command_line: "*System.Reflection.Assembly*Load*"
